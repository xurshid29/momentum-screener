# Production environment template. Copy to /opt/pnldash/.env on the droplet
# and fill in real values. NEVER commit the populated file.

# ─── Database ─────────────────────────────────────────────────────────
POSTGRES_DB=pnldash
POSTGRES_USER=pnldash
POSTGRES_PASSWORD=                # generate: openssl rand -base64 32 | tr -d /=+
DATABASE_URL=postgres://pnldash:CHANGE_ME@postgres:5432/pnldash?sslmode=disable

# ─── External APIs ────────────────────────────────────────────────────
FINVIZ_API_TOKEN=
BENZINGA_API_TOKEN=                # optional; without it only Finviz + Yahoo news

# ─── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=                        # generate: openssl rand -hex 64
JWT_EXPIRES_IN=7d
